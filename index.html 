      border-collapse:collapse;
      margin-top:8px;
    }

    th, td{
      border:1px solid #9bb7a5;
      padding:8px 8px;
      vertical-align:top;
      text-align:left;
    }

    th{
      background:#e9f2eb;
      color:var(--vert-fonce);
      font-weight:700;
    }

    .signature{
      min-height:70px;
      border-bottom:2px dotted #7b8d81;
      margin-top:8px;
    }

    .footer-note{
      margin-top:18px;
      color:var(--muted);
      font-size:0.9rem;
      font-style:italic;
    }

    @media (max-width:760px){
      .grille{
        grid-template-columns:1fr;
      }

      .actions{
        display:block;
      }

      .actions button{
        width:100%;
        margin-top:8px;
      }

      .page-a4{
        width:100%;
        min-height:auto;
        padding:18px 16px;
      }
    }

    @media print{
      @page{
        size:A4;
        margin:0;
      }

      body{
        background:#fff;
      }

      header, .formulaire, .intro, .no-print{
        display:none !important;
      }

      main{
        max-width:none;
        margin:0;
        padding:0;
      }

      #fiche{
        display:block !important;
      }

      .page-a4{
        width:210mm;
        min-height:297mm;
        margin:0;
        border:none;
        box-shadow:none;
        border-radius:0;
      }

      th{
        background:#f0f0f0 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
    }
  </style>
</head>
<body>
  <header>
    <h1>Bot pédagogique APC Bénin</h1>
    <p>Préparation des fiches pédagogiques du primaire</p>
  </header>

  <main>
    <section class="panel formulaire">
      <h2>Préparer une séance</h2>
      <p class="note">Renseignez les informations de base. Adaptez la fiche aux programmes officiels et au niveau réel des élèves.</p>

      <div class="grille">
        <div class="champ">
          <label for="classe">Classe</label>
          <select id="classe">
            <option>CI</option>
            <option>CP</option>
            <option>CE1</option>
            <option>CE2</option>
            <option>CM1</option>
            <option>CM2</option>
          </select>
        </div>

        <div class="champ">
          <label for="discipline">Discipline</label>
          <select id="discipline">
            <option>Français</option>
            <option>Mathématiques</option>
            <option>Éducation sociale</option>
            <option>EST</option>
            <option>Éducation artistique</option>
            <option>EPS</option>
          </select>
        </div>

        <div class="champ">
          <label for="domaine">Domaine / sous-domaine</label>
          <input id="domaine" placeholder="Ex. : Lecture, Numération, Géométrie" />
        </div>

        <div class="champ">
          <label for="ecole">École</label>
          <input id="ecole" placeholder="Nom de l'école" />
        </div>

        <div class="champ">
          <label for="enseignant">Enseignant(e)</label>
          <input id="enseignant" placeholder="Nom de l'enseignant(e)" />
        </div>

        <div class="champ">
          <label for="date">Date</label>
          <input id="date" type="date" />
        </div>

        <div class="champ">
          <label for="duree">Durée</label>
          <input id="duree" placeholder="Ex. : 45 minutes" />
        </div>

        <div class="champ">
          <label for="periode">Période / trimestre</label>
          <input id="periode" placeholder="Ex. : 1er trimestre" />
        </div>

        <div class="champ large">
          <label for="titre">Titre de la leçon</label>
          <input id="titre" placeholder="Ex. : Les nombres de 0 à 10" />
        </div>

        <div class="champ large">
          <label for="competence">Compétence(s) visée(s)</label>
          <textarea id="competence" placeholder="Préciser la ou les compétences visées"></textarea>
        </div>

        <div class="champ large">
          <label for="objectif">Objectif spécifique</label>
          <textarea id="objectif" placeholder="Ce que l’élève doit être capable de faire à la fin de la séance"></textarea>
        </div>

        <div class="champ large">
          <label for="situation">Situation d’apprentissage</label>
          <textarea id="situation" placeholder="Décrire la situation-problème ou la situation concrète"></textarea>
        </div>

        <div class="champ large">
          <label for="materiel">Matériel didactique</label>
          <input id="materiel" placeholder="Tableau, ardoises, images, objets, cahiers..." />
        </div>
      </div>

      <div class="actions">
        <button type="button" class="btn-principal" onclick="generer()">Générer la fiche</button>
        <button type="button" class="btn-secondaire" onclick="remplirExemple()">Exemple</button>
        <button type="button" class="btn-secondaire" onclick="reinitialiser()">Réinitialiser</button>
        <button type="button" class="btn-secondaire" onclick="window.print()">Télécharger en PDF</button>
      </div>
    </section>

    <section id="fiche" class="no-print">
      <div class="page-a4 fiche">
        <h2 class="titre-fiche">FICHE DE PRÉPARATION DE SÉANCE</h2>
        <div id="entete" class="entete"></div>

        <h3>1. Compétence(s) visée(s)</h3>
        <p id="c"></p>

        <h3>2. Objectif spécifique</h3>
        <p id="o"></p>

        <h3>3. Situation d’apprentissage</h3>
        <p id="s"></p>

        <h3>4. Déroulement de la séance</h3>
        <table>
          <thead>
            <tr>
              <th>Étapes / consignes de l’enseignant</th>
              <th>Activités des élèves / résultats attendus</th>
            </tr>
          </thead>
          <tbody id="phases"></tbody>
        </table>

        <h3>5. Évaluation</h3>
        <p id="evaluation"></p>

        <h3>6. Remédiation et consolidation</h3>
        <p id="remediation"></p>

        <h3>7. Retour et projection</h3>
        <p id="projection"></p>

        <h3>8. Observations / commentaires</h3>
        <div class="signature"></div>

        <p class="footer-note">Fiche indicative à vérifier et à adapter aux programmes officiels et au niveau réel des élèves.</p>
      </div>
    </section>

    <p class="note intro">Prototype pédagogique : l’enseignant reste responsable de la validation et de l’adaptation du contenu.</p>
  </main>

  <script>
    function lire(id){
      return document.getElementById(id).value.trim();
    }

    function securiser(texte){
      return String(texte).replace(/[&<>"']/g, function(c){
        const map = {
          '&':'&amp;',
          '<':'&lt;',
          '>':'&gt;',
          '"':'&quot;',
          "'":'&#39;'
        };
        return map[c];
      });
    }

    function formatDate(dateStr){
      if(!dateStr) return 'À préciser';
      const d = new Date(dateStr + 'T00:00:00');
      if(Number.isNaN(d.getTime())) return 'À préciser';
      return d.toLocaleDateString('fr-FR', {
        day:'2-digit',
        month:'long',
        year:'numeric'
      });
    }

    function sauvegarderLocal(){
      const data = {};
      ['classe','discipline','domaine','ecole','enseignant','date','duree','periode','titre','competence','objectif','situation','materiel']
        .forEach(id => data[id] = document.getElementById(id).value);
      localStorage.setItem('fiche_apc_benin_finale', JSON.stringify(data));
    }

    function chargerLocal(){
      const data = JSON.parse(localStorage.getItem('fiche_apc_benin_finale') || '{}');
      Object.entries(data).forEach(([key, value]) => {
        const el = document.getElementById(key);
        if(el) el.value = value || '';
      });
    }

    function remplirExemple(){
      document.getElementById('classe').value = 'CP';
      document.getElementById('discipline').value = 'Mathématiques';
      document.getElementById('domaine').value = 'Numération';
      document.getElementById('ecole').value = 'École primaire de Zogbo';
      document.getElementById('enseignant').value = 'Mme H. Gbado';
      document.getElementById('date').value = new Date().toISOString().slice(0,10);
      document.getElementById('duree').value = '45 minutes';
      document.getElementById('periode').value = '1er trimestre';
      document.getElementById('titre').value = 'Les nombres de 0 à 10';
      document.getElementById('competence').value = 'Comparer, lire et écrire des nombres entiers jusqu’à 10 et les utiliser dans des situations simples.';
      document.getElementById('objectif').value = 'À la fin de la séance, l’élève sera capable de lire, écrire et comparer les nombres de 0 à 10.';
      document.getElementById('situation').value = 'Dans la cour de l’école, les élèves comptent les feuilles, les crayons et les bancs pour former des collections.';
      document.getElementById('materiel').value = 'Tableau, craies, objets du quotidien, cartes chiffres, ardoise';
      sauvegarderLocal();
    }

    function reinitialiser(){
      ['classe','discipline','domaine','ecole','enseignant','date','duree','periode','titre','competence','objectif','situation','materiel']
        .forEach(id => document.getElementById(id).value = '');
      localStorage.removeItem('fiche_apc_benin_finale');
      document.getElementById('fiche').style.display = 'none';
    }

    function buildPhases(){
      return [
        {
          phase:'1. Mise en route',
          consigne:'Saluer les élèves, faire un rappel rapide sur les nombres déjà connus. Poser des questions simples et faire compter ensemble.',
          resultat:'Les élèves se remettent en mémoire les notions déjà étudiées et participent activement.'
        },
        {
          phase:'2. Découverte',
          consigne:'Présenter la situation d’apprentissage et faire observer les objets ou images. Demander : « Combien y a-t-il d’objets ? »',
          resultat:'Les élèves observent, comptent et comprennent le problème à résoudre.'
        },
        {
          phase:'3. Recherche',
          consigne:'Donner une consigne claire. Faire travailler individuellement ou en petits groupes.',
          resultat:'Les élèves recherchent, échangent et cherchent des solutions à la situation proposée.'
        },
        {
          phase:'4. Mise en commun',
          consigne:'Inviter quelques élèves à expliquer leur démarche. Faire comparer les réponses et corriger ensemble.',
          resultat:'Les élèves exposent leurs réponses, justifient leur démarche et corrigent leurs erreurs.'
        },
        {
          phase:'5. Structuration',
          consigne:'Guider la formulation de la règle ou de la méthode. Faire noter l’essentiel sur le cahier.',
          resultat:'Les élèves retiennent la notion et écrivent la trace écrite.'
        },
        {
          phase:'6. Évaluation',
          consigne:'Proposer une courte activité individuelle ou collective pour vérifier l’acquisition.',
          resultat:'Les élèves montrent ce qu’ils ont compris et l’enseignant constate les acquis.'
        },
        {
          phase:'7. Remédiation',
          consigne:'Reprendre les difficultés sous forme d’exercices guidés, d’exemples simples et de manipulations.',
          resultat:'Les élèves en difficulté corrigent leurs erreurs et consolident la notion.'
        },
        {
          phase:'8. Retour',
          consigne:'Demander ce qui a été appris et dans quelles situations ils peuvent le réutiliser.',
          resultat:'Les élèves font le bilan de la séance et expriment leur compréhension.'
        }
      ];
    }

    function generer(){
      const titre = lire('titre');
      if(!titre){
        alert('Veuillez saisir le titre de la leçon.');
        document.getElementById('titre').focus();
        return;
      }

      sauvegarderLocal();

      document.getElementById('entete').innerHTML =
        '<p>' +
        '<b>Classe :</b> ' + securiser(lire('classe')) +
        ' | <b>Discipline :</b> ' + securiser(lire('discipline')) +
        '<br><b>Domaine / Sous-domaine :</b> ' + securiser(lire('domaine') || 'À préciser') +
        '<br><b>École :</b> ' + securiser(lire('ecole') || 'À préciser') +
        '<br><b>Enseignant(e) :</b> ' + securiser(lire('enseignant') || 'À préciser') +
        '<br><b>Date :</b> ' + securiser(formatDate(lire('date'))) +
        '<br><b>Durée :</b> ' + securiser(lire('duree') || 'À préciser') +
        '<br><b>Période :</b> ' + securiser(lire('periode') || 'À préciser') +
        '<br><b>Leçon :</b> ' + securiser(titre) +
        '<br><b>Matériel :</b> ' + securiser(lire('materiel') || 'À préciser') +
        '</p>';

      document.getElementById('c').textContent =
        lire('competence') || 'À compléter selon le programme officiel.';

      document.getElementById('o').textContent =
        lire('objectif') || 'À préciser selon la compétence visée.';

      document.getElementById('s').textContent =
        lire('situation') || 'À compléter par une situation adaptée aux élèves.';

      const phases = buildPhases();
      document.getElementById('phases').innerHTML = phases.map(function(p){
        return '<tr>' +
          '<td><b>' + securiser(p.phase) + '</b><br><b>Consigne :</b> ' + securiser(p.consigne) + '</td>' +
          '<td>' + securiser(p.resultat) + '</td>' +
          '</tr>';
      }).join('');

      document.getElementById('evaluation').textContent =
        'Proposer un exercice court et pertinent sur « ' + titre + ' ». Vérifier si les critères de réussite sont atteints et relever les difficultés éventuelles.';

      document.getElementById('remediation').textContent =
        'Reprendre les difficultés observées à partir d’exemples simples, de manipulations et d’exercices différenciés. Prévoir un appui pour les élèves en difficulté et un enrichissement pour les autres.';

      document.getElementById('projection').textContent =
        'Faire verbaliser les acquis de la séance et proposer une situation de réinvestissement dans la vie quotidienne ou dans une autre discipline.';

      document.getElementById('fiche').style.display = 'block';
      document.getElementById('fiche').scrollIntoView({ behavior:'smooth', block:'start' });
    }

    window.addEventListener('DOMContentLoaded', function(){
      chargerLocal();
    });
  </script>
</body>
</html>