<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#185d39"><title>Bot pédagogique APC Bénin</title>
<style>
:root{--v:#185d39;--c:#edf5ef}*{box-sizing:border-box}body{margin:0;background:#f2f5f2;color:#202820;font:16px Arial;line-height:1.5}header{background:var(--v);color:white;text-align:center;padding:20px}main{max-width:1050px;margin:20px auto;padding:0 12px}.panel{background:white;padding:18px;border-radius:12px;margin-bottom:16px;box-shadow:0 2px 8px #0001}h2,h3{color:var(--v)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}label{display:block;font-weight:bold;margin-bottom:5px}input,select,textarea{width:100%;padding:10px;border:1px solid #bac7bc;border-radius:6px;font:inherit}textarea{min-height:75px}.full{grid-column:1/-1}button{padding:11px 15px;border:0;border-radius:7px;background:var(--v);color:white;font-weight:bold}.alt{background:#526257}.gold{background:#956908}.actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:15px}.phase{border:1px solid #d5ddd6;padding:12px;border-radius:8px;margin:10px 0}table{border-collapse:collapse;width:100%;margin:12px 0}td,th{border:1px solid #89988d;padding:7px;text-align:left;vertical-align:top}th{background:var(--c)}#resultat{overflow-wrap:anywhere}.notice{background:#fff8e7;padding:10px;border-left:4px solid #d5a53b;font-size:14px}#message{color:var(--v);font-weight:bold}@media print{header,.formulaire,footer{display:none!important}main{margin:0;padding:0}.panel{box-shadow:none;padding:0}#resultat{border:0}@page{size:A4;margin:14mm}}
</style></head><body>
<header><h1>Bot pédagogique APC Bénin</h1><p>Fiches, résumés, exercices corrigés et évaluations — CI à CM2</p></header>
<main>
<section class="panel formulaire"><h2>1. Choix du contenu</h2><p class="notice">Le catalogue est une base de travail. Les contenus doivent être vérifiés avec les programmes, guides et documents officiels en vigueur. Une proposition pédagogique n'est pas automatiquement un contenu officiel.</p>
<div class="grid">
<div><label>Classe</label><select id="cl"><option>CI</option><option>CP</option><option selected>CE1</option><option>CE2</option><option>CM1</option><option>CM2</option></select></div>
<div><label>Discipline</label><select id="di"></select></div><div><label>Notion</label><select id="no"></select></div>
<div><label>Document à produire</label><select id="type"><option value="fiche">Fiche pédagogique complète</option><option value="resume">Résumé du cours</option><option value="exos">Exercices avec corrigés</option><option value="eval">Évaluation avec barème et remédiation</option><option value="tout">Pack complet</option></select></div>
<div><label>Durée totale (minutes)</label><input id="duree" type="number" min="1" value="30"></div><div><label>Statut</label><select id="statut"><option>Proposition pédagogique à valider</option><option>Modèle issu d'un document fourni</option><option>Officiel vérifié par l'enseignant</option></select></div>
<div><label>École</label><input id="ecole"></div><div><label>Enseignant(e)</label><input id="ens"></div><div><label>Date</label><input id="date" type="date"></div><div><label>SA / Séquence</label><input id="sa"></div>
<div class="full"><label>Compétence visée (à vérifier)</label><textarea id="comp"></textarea></div><div class="full"><label>Objectif d'apprentissage</label><textarea id="obj"></textarea></div><div class="full"><label>Prérequis</label><textarea id="pre"></textarea></div><div class="full"><label>Matériel didactique</label><textarea id="mat"></textarea></div></div>
<h2>2. Déroulement de la séance</h2><p>Les phases se redistribuent automatiquement quand tu modifies la durée totale. Tu peux aussi modifier chaque phase.</p><div id="phases"></div>
<div class="actions"><button id="go">Générer le document</button><button id="copy" class="alt">Copier</button><button id="print" class="gold">Imprimer / PDF</button><button id="reset" class="alt">Réinitialiser</button></div><p id="message" role="status"></p></section>
<section class="panel"><h2>3. Document généré</h2><div id="resultat">Choisis une notion puis génère le document.</div></section></main><footer>Bot pédagogique APC Bénin — outil d'aide à la préparation.</footer>
<script>
"use strict";
const $=x=>document.getElementById(x),v=x=>$(x).value.trim();
const domaines=["Français","Mathématiques — Arithmétique","Mathématiques — Géométrie","Mathématiques — Mesures","Éducation sociale — Morale","Éducation sociale — Civisme","Éducation sociale — Histoire-Géographie","Éducation sociale — Langues et culture","EST","Éducation artistique — Dessin","Éducation artistique — Chant","Éducation artistique — Travaux manuels","Éducation artistique — Poésie","Éducation artistique — Conte","Éducation artistique — Couture","EPS"];
const catalogue={
"CI":["Écoute et consignes","Dénombrement","Formes simples","Hygiène corporelle","Règles de vie","Chants et comptines","Marcher et courir"],
"CP":["Lecture de syllabes et de mots","Nombres de 0 à 99","Addition et soustraction","Le cube","Comparaison de longueurs","Hygiène et santé","Saut vers l'avant, saut vers l'arrière"],
"CE1":["Les diphtongues","Lecture de textes courts","La phrase","Numération et opérations","Figures planes","Mesure du temps","Respect et solidarité","Hygiène et santé","Dessin d'observation","Jeux collectifs"],
"CE2":["Lecture et compréhension","Grammaire et conjugaison","Numération","Résolution de problèmes","Droites et figures planes","Longueurs, masses et capacités","Responsabilité et solidarité","Santé et environnement"],
"CM1":["Production de textes","Fractions et nombres décimaux","Construction de figures","Aires et périmètres","Citoyenneté et biens communs","Histoire et géographie du milieu","Santé et environnement"],
"CM2":["Rédaction","Proportionnalité et problèmes","Angles et constructions","Mesures et conversions","Citoyenneté et vie démocratique","Histoire et géographie du Bénin","Patrimoine culturel"]};
const base=[
["1. Activités préparatoires",5,"Prépare le matériel et organise-toi.","L'apprenant est prêt.","Collectif"],
["2. Introduction / rappel",5,"Rappelle les acquis et observe la situation.","Les acquis sont mobilisés.","Collectif"],
["3. Construction des apprentissages",10,"Observe, cherche, échange et propose une démarche.","Une démarche est proposée.","Individuel et collectif"],
["4. Entraînement / exécution",5,"Réalise la tâche et compare les réponses.","La tâche est réalisée.","Individuel / groupe"],
["5. Évaluation / objectivation",3,"Explique ce que tu as appris et réponds à une tâche courte.","Les acquis sont vérifiés.","Individuel"],
["6. Post-apprentissage",2,"Fais le bilan et range le matériel.","Le réinvestissement est identifié.","Collectif"]];
function selectNotions(){let d=$("di");d.replaceChildren();domaines.forEach(x=>d.add(new Option(x,x)));charger();}
function charger(){let n=$("no");n.replaceChildren();(catalogue[v("cl")]||[]).forEach(x=>n.add(new Option(x,x)));}
function phases(){let root=$("phases");root.replaceChildren();base.forEach((p,i)=>{let b=document.createElement("div");b.className="phase";b.append(el("h3",p[0]));let g=document.createElement("div");g.className="grid";field(g,"d"+i,"Durée (min)",p[1],"number");field(g,"s"+i,"Stratégie",p[4]);field(g,"c"+i,"Consignes / activités",p[2],"textarea",true);field(g,"a"+i,"Résultats attendus",p[3],"textarea",true);b.append(g);root.append(b);});}
function field(root,id,label,value,type="text",full=false){let w=document.createElement("div");if(full)w.className="full";let l=el("label",label);l.htmlFor=id;let x=document.createElement(type==="textarea"?"textarea":"input");x.id=id;if(type!=="textarea")x.type=type;x.value=value;if(type==="number")x.min="0";w.append(l,x);root.append(w);}
function el(tag,txt){let x=document.createElement(tag);x.textContent=txt;return x;}
function lire(){return base.map((p,i)=>({phase:p[0],d:+$("d"+i).value||0,strategie:v("s"+i),consigne:v("c"+i),attendu:v("a"+i)}));}
function repartition(){let total=Math.max(1,Math.floor(+v("duree")||1)),ps=lire(),sum=ps.reduce((a,p)=>a+p.d,0),raw=ps.map(p=>(sum?p.d/sum:1/6)*total),vals=raw.map(Math.floor),reste=total-vals.reduce((a,b)=>a+b,0),ordre=raw.map((x,i)=>[i,x-Math.floor(x)]).sort((a,b)=>b[1]-a[1]);for(let k=0;k<reste;k++)vals[ordre[k%6][0]]++;vals.forEach((x,i)=>$("d"+i).value=x);}
function data(){
 let notion=v("no"),isDip=v("cl")==="CE1"&&v("di")==="Français"&&notion==="Les diphtongues";
 if(isDip)return {resume:"Une diphtongue est une association de deux sons vocaliques prononcés dans une même syllabe, avec un mouvement de la voix. Des mots comme « roi » ou « voiture » peuvent servir de supports d'écoute du son /wa/. Attention : deux voyelles écrites côte à côte ne forment pas toujours une diphtongue.",objectif:"Repérer et prononcer les sons ciblés dans des mots familiers, puis les employer dans une phrase.",pre:"Écouter et répéter des mots, distinguer les syllabes et reconnaître des voyelles.",mat:"Images, étiquettes-mots, tableau et ardoises.",situation:"Présenter des images (roi, voiture, oiseau). Faire nommer les images et écouter les sons.",trace:"J'écoute le mot, je le prononce lentement et je repère le son étudié. Je retrouve ce son dans d'autres mots. Deux voyelles écrites côte à côte ne forment pas toujours une diphtongue.",ex:[["Entoure le mot contenant /wa/ : roi – papa – table.","roi"],["Complète : voi....re.","voiture"],["Compose une phrase avec « voiture ».","Exemple : La voiture roule sur la route."]],ev:[["Repère le mot contenant /wa/.","2 pts : roi."],["Prononce « voiture ».","2 pts : prononciation intelligible."],["Compose une phrase avec « roi ».","2 pts : phrase correcte."],["Explique comment tu as repéré le son.","2 pts : écoute et repérage."]],rem:"Reprendre l'écoute avec des images et des mots familiers. Faire répéter lentement, opposer un mot contenant le son cible à un autre, puis faire classer les étiquettes."};
 return {resume:"Cette séance porte sur « "+notion+" » en "+v("di")+" pour la classe de "+v("cl")+". Partir d'une situation concrète, faire observer ou manipuler, guider la recherche et faire formuler la synthèse. Compléter avec le guide pédagogique de la classe.",objectif:"Mobiliser les connaissances et techniques liées à « "+notion+" » pour traiter une situation adaptée au niveau.",pre:"Faire rappeler les apprentissages antérieurs liés à la notion. À préciser selon le guide.",mat:"Supports concrets du milieu, images ou objets, tableau, ardoises et cahiers.",situation:"Présenter une situation-problème issue du milieu de vie. Demander d'observer, décrire et proposer des pistes de solution.",trace:"À compléter avec la règle, la démarche, le schéma ou la synthèse exacte de la notion. Vérifier dans le document de référence.",ex:[["Donne un exemple lié à la notion étudiée.","Exemple correct et expliqué."],["Réalise une activité simple sur « "+notion+" ».","Corriger selon la démarche du guide."],["Explique ce que tu as appris.","Réponse cohérente avec la notion."]],ev:[["Question de compréhension.","2 pts : réponse juste."],["Application dans une situation nouvelle.","4 pts : démarche et résultat corrects."],["Explique ta démarche.","2 pts : explication claire."]],rem:"Identifier l'erreur, reprendre avec un support concret, proposer un exercice plus simple, accompagner puis vérifier à nouveau."};
}
function section(root,t,txt){root.append(el("h3",t),el("p",txt||"À compléter."));}
function table(root,heads,rows){let t=document.createElement("table"),h=document.createElement("tr");heads.forEach(x=>h.append(el("th",x)));let hd=document.createElement("thead");hd.append(h);t.append(hd);let b=document.createElement("tbody");rows.forEach(row=>{let r=document.createElement("tr");row.forEach(x=>r.append(el("td",String(x))));b.append(r);});t.append(b);root.append(t);}
function generer(){let d=data(),type=v("type"),r=$("resultat");r.replaceChildren();r.append(el("h2","BOT PÉDAGOGIQUE APC BÉNIN"),el("h3",v("no")));table(r,["Élément","Information"],[["Classe",v("cl")],["Discipline",v("di")],["École",v("ecole")||"À compléter"],["Enseignant",v("ens")||"À compléter"],["Date",v("date")||"À compléter"],["Durée",v("duree")+" min"],["SA / séquence",v("sa")||"À compléter"],["Statut",v("statut")]]);
let pack=type==="tout";if(["resume","tout"].includes(type)){section(r,"RÉSUMÉ DU COURS",d.resume);section(r,"OBJECTIF",v("obj")||d.objectif);section(r,"PRÉREQUIS",v("pre")||d.pre);section(r,"TRACE ÉCRITE",d.trace);}
if(["exos","tout"].includes(type)){r.append(el("h3","EXERCICES ET CORRIGÉS"));table(r,["N°","Consigne","Corrigé"],d.ex.map((x,i)=>[i+1,x[0],x[1]]));}
if(["eval","tout"].includes(type)){r.append(el("h3","ÉVALUATION ET BARÈME"));table(r,["N°","Question / tâche","Critère / barème"],d.ev.map((x,i)=>[i+1,x[0],x[1]]));section(r,"REMÉDIATION",d.rem);}
if(["fiche","tout"].includes(type)){section(r,"COMPÉTENCE",v("comp")||"À renseigner selon le programme officiel.");section(r,"OBJECTIF",v("obj")||d.objectif);section(r,"PRÉREQUIS",v("pre")||d.pre);section(r,"SITUATION-PROBLÈME",d.situation);section(r,"MATÉRIEL",v("mat")||d.mat);r.append(el("h3","DÉROULEMENT DÉTAILLÉ"));let ps=lire(),sum=ps.reduce((a,p)=>a+p.d,0);table(r,["Phase / durée","Consignes","Stratégies","Résultats attendus"],ps.map(p=>[p.phase+" — "+p.d+" min",p.consigne,p.strategie,p.attendu]));section(r,"TOTAL DES DURÉES",sum+" min / durée annoncée : "+v("duree")+" min");section(r,"SYNTHÈSE",d.trace);section(r,"REMÉDIATION",d.rem);}
r.append(el("p","Document généré par le Bot pédagogique APC Bénin. Les contenus non vérifiés sont des propositions à contrôler avec les programmes, guides et documents officiels applicables."));$("message").textContent="Document généré. Vérifie les contenus et les durées avant utilisation.";}
$("cl").addEventListener("change",charger);$("di").addEventListener("change",charger);$("duree").addEventListener("input",repartition);$("go").addEventListener("click",generer);$("print").addEventListener("click",()=>{generer();window.print()});$("copy").addEventListener("click",async()=>{generer();try{await navigator.clipboard.writeText($("resultat").innerText);$("message").textContent="Document copié."}catch(e){let rg=document.createRange();rg.selectNodeContents($("resultat"));let s=window.getSelection();s.removeAllRanges();s.addRange(rg);$("message").textContent="Texte sélectionné : appui long puis Copier."}});$("reset").addEventListener("click",()=>{if(!confirm("Réinitialiser ?"))return;$("cl").value="CE1";$("di").value="Français";$("type").value="fiche";$("duree").value=30;["ecole","ens","date","sa","comp","obj","pre","mat"].forEach(x=>$(x).value="");charger();phases();repartition();$("resultat").textContent="Choisis une notion puis génère le document."});selectNotions();phases();repartition();
</script></body></html>